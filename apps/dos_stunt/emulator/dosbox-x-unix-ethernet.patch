+++ b/src/misc/ethernet.cpp
@@ -30,0 +31,62 @@
+#ifndef _WIN32
+#include <cerrno>
+#include <cstdlib>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+// Local raw-Ethernet transport for emulator tests without capture privileges.
+class UnixEthernetConnection final : public EthernetConnection {
+public:
+    ~UnixEthernetConnection() override {
+        if (fd >= 0) close(fd);
+        if (!local_path.empty()) unlink(local_path.c_str());
+    }
+
+    bool Initialize(Section*) override {
+        const char* local = getenv("DOSBOX_X_ETHERNET_LOCAL");
+        const char* peer = getenv("DOSBOX_X_ETHERNET_PEER");
+        if (!local || !peer || !*local || !*peer ||
+            strlen(local) >= sizeof(sockaddr_un::sun_path) ||
+            strlen(peer) >= sizeof(sockaddr_un::sun_path)) {
+            LOG_MSG("ETHERNET: Set short DOSBOX_X_ETHERNET_LOCAL and DOSBOX_X_ETHERNET_PEER socket paths");
+            return false;
+        }
+        fd = socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK, 0);
+        if (fd < 0) return false;
+        sockaddr_un address = {};
+        address.sun_family = AF_UNIX;
+        strcpy(address.sun_path, local);
+        if (bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) < 0) {
+            LOG_MSG("ETHERNET: Cannot bind %s: %s", local, strerror(errno));
+            return false;
+        }
+        local_path = local;
+        peer_path = peer;
+        return true;
+    }
+
+    void SendPacket(const uint8_t* packet, int len) override {
+        sockaddr_un address = {};
+        address.sun_family = AF_UNIX;
+        strcpy(address.sun_path, peer_path.c_str());
+        sendto(fd, packet, len, MSG_DONTWAIT,
+               reinterpret_cast<sockaddr*>(&address), sizeof(address));
+    }
+
+    void GetPackets(std::function<void(const uint8_t*, int)> callback) override {
+        uint8_t packet[2048];
+        for (unsigned n = 0; n < 64; ++n) {
+            const ssize_t len = recv(fd, packet, sizeof(packet), MSG_DONTWAIT);
+            if (len <= 0) break;
+            callback(packet, static_cast<int>(len));
+        }
+    }
+
+private:
+    int fd = -1;
+    std::string local_path;
+    std::string peer_path;
+};
+#endif
+
